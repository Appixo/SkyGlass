{
  "manifest_version": 3,
  "name": "FR24 Clear View",
  "version": "1.1.0",
  "description": "A cleaner Flightradar24: full-width map, compact flight panel, no ads, rain radar and keyboard shortcuts.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.rainviewer.com/*",
    "https://tilecache.rainviewer.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.flightradar24.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.flightradar24.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FR24 Clear View",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fr24-clear-view@gekgekke.gmail.com",
      "strict_min_version": "121.0"
    }
  }
}
